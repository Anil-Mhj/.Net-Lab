@{
    ViewData["Title"] = "Home Page";
}


<div class="hero-section text-center" style="position:relative; z-index:1;">
    <h1>Student Registration System</h1>
    <p>Manage student enrollments efficiently with our modern platform</p>
    <div class="d-flex justify-content-center gap-3 flex-wrap">
        <a asp-controller="Student" asp-action="Create" class="btn btn-hero-light">Register New Student</a>
        <a asp-controller="Student" asp-action="Index" class="btn btn-hero-outline">View All Students</a>
    </div>
</div>

