@model StudentRegistration.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<h2>Student Details</h2>

<div class="row">
    <div class="col-md-4">
        <table class="table">
            <tbody>
                <tr>
                    <th>Student ID</th>
                    <td>@Model.StudentId</td>
                </tr>
                <tr>
                    <th>Name</th>
                    <td>@Model.Name</td>
                </tr>
                <tr>
                    <th>Faculty</th>
                    <td>@Model.Faculty</td>
                </tr>
                <tr>
                    <th>Email</th>
                    <td>@Model.Email</td>
                </tr>
                <tr>
                    <th>Enrollment Date</th>
                    <td>@Model.EnrollmentDate.ToShortDateString()</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>