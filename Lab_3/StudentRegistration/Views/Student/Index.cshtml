@model IEnumerable<StudentRegistration.Models.Student>

@{
    ViewData["Title"] = "Student Index";
}

<h2>Student Registration</h2>

<p>
    <a asp-action="Create">Create New Student</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Student ID</th>
            <th>Name</th>
            <th>Faculty</th>
            <th>Email</th>
            <th>Enrollment Date</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.StudentId</td>
                <td>@item.Name</td>
                <td>@item.Faculty</td>
                <td>@item.Email</td>
                <td>@item.EnrollmentDate.ToShortDateString()</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.StudentId" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.StudentId" class="btn btn-sm btn-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.StudentId" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>